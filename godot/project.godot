; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="서울 히어로"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="SeoulHeroGodot"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Content="*res://scripts/core/content.gd"
Profile="*res://scripts/save/profile.gd"
Sound="*res://scripts/presentation/sound.gd"

[display]

window/size/viewport_width=915
window/size/viewport_height=412
window/size/window_width_override=1372
window/size/window_height_override=618
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.06, 1)
