; Standalone image UI proposals. No game autoloads, gameplay or save adapters.
config_version=5

[application]
config/name="서울 히어로 · 이미지 UI 시안"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=915
window/size/viewport_height=412
window/size/window_width_override=915
window/size/window_height_override=412
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

